# Root .env example — copy to .env and fill values

# Server
PORT=5000
BASE_PATH=/

# Database (Postgres connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/deepclean

# Gemini API key for AI threat analysis
GEMINI_API_KEY=your_gemini_api_key_here

# On-chain deployment values (from deploy_move.sh)
QUARANTINE_PACKAGE_ID=0x...
QUARANTINE_ADMIN_CAP_ID=0x...
AGENT_PRIVATE_KEY=...
SUI_NETWORK=devnet

# Optional overrides used by scripts
API_BASE=http://localhost:5000/api

# Security: do NOT commit your .env
