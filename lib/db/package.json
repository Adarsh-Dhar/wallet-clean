{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate":   "prisma generate --schema ./prisma/schema.prisma",
    "migrate":    "prisma migrate deploy --schema ./prisma/schema.prisma",
    "migrate:dev":"prisma migrate dev --schema ./prisma/schema.prisma",
    "studio":     "prisma studio --schema ./prisma/schema.prisma",
    "push":       "prisma db push --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.1.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prisma": "^5.22.0"
  }
}