{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate --schema ./prisma/schema.prisma",
    "migrate": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema ./prisma/schema.prisma",
    "studio": "prisma studio --schema ./prisma/schema.prisma",
    "push": "prisma db push --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.1.4",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.5.6",
    "prisma": "^5.22.0"
  }
}
